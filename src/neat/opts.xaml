<Window
    x:Class="neat.Opts"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The background and the theme are set in code (opts.xaml.cs, Paint), from the
         window colour. KeyboardAcceleratorPlacementMode is Hidden so the Esc
         accelerator does not pop up a tooltip. -->
    <Grid
        x:Name="root"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Empty strip along the top: it drags the window, and the system close
             button sits over its right end. Nothing clickable may go in here
             (it would need the pass-through rectangles win.bar.cs sets up). -->
        <Grid x:Name="strip" Grid.Row="0" Background="Transparent"/>

        <!-- One icon-over-label tab per page; the buttons are made in code. -->
        <StackPanel
            x:Name="tabs"
            Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Spacing="4"
            Margin="0,4,0,8"/>

        <!-- The selected page is put in here. -->
        <ScrollViewer
            x:Name="scroll"
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"/>
    </Grid>
</Window>
