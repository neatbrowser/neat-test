<Application
    x:Class="neat.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Look constants. Change a number here and it applies everywhere. -->
            <Thickness x:Key="pad">6</Thickness>
            <CornerRadius x:Key="r_side">10</CornerRadius>
            <CornerRadius x:Key="r_web">10</CornerRadius>

            <!-- Temporary window background. Later phases replace it with the
                 gradient generated by the theme color editor. -->
            <LinearGradientBrush x:Key="bg" StartPoint="0,0" EndPoint="0.4,1">
                <GradientStop Color="#FF3B4A1A" Offset="0"/>
                <GradientStop Color="#FF2E2B2E" Offset="0.55"/>
                <GradientStop Color="#FF3A1A4A" Offset="1"/>
            </LinearGradientBrush>
        </ResourceDictionary>
    </Application.Resources>
</Application>
