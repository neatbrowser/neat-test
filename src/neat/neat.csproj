<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

    <AssemblyName>neat</AssemblyName>
    <RootNamespace>neat</RootNamespace>
    <Product>NEAT Browser</Product>
    <Version>0.16</Version>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- The icon file, named once here. It is embedded into neat.exe (ApplicationIcon):
         this is the icon Explorer, the taskbar and any shortcut to neat.exe (desktop,
         Start menu) show. The same file is also copied next to neat.exe, see the
         ItemGroup at the end, for the settings window to load at run time. -->
    <AppIco>..\..\browser\branding\official\default.ico</AppIco>
    <ApplicationIcon>$(AppIco)</ApplicationIcon>

    <!-- x64 only for now: the bundled Fixed Version WebView2 runtime below
         is the x64 build. Always build with -p:Platform=x64. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- Unpackaged + self-contained: a plain folder with neat.exe that
         runs without MSIX packaging and without a separately installed
         Windows App Runtime or .NET runtime. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows App SDK 2.5.1 (stable, 16 Sep 2026). Pinned to an exact version
         on purpose so builds are reproducible. Moved up from 1.8.12 to pick up
         the XAML crash fixes of the 2.x line (ListView, popups, shutdown).
         From 2.0 on the version is plain SemVer (no more 1.8.260921001 style).
         The metapackage brings in the WinUI 3 WebView2 control, the Windows
         SDK build tools and CsWinRT transitively, so none of those are listed
         here. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />

    <!-- Fixed Version WebView2 runtime, bundled next to neat.exe in a
         "WebView2" folder (copied automatically on build/publish). Same
         community package Mozart uses. It is large (~250 MB), so
         the first restore is slow; that is expected. See
         web/env.cs for how the app points WebView2 at it.
         Since 152.0.4191.53 the runtime no longer fits in one NuGet package,
         so it is split in two: both are required, and they must stay on the
         same version. -->
    <PackageReference Include="WebView2.Runtime.X64" Version="156.0.4314.42" />
    <PackageReference Include="WebView2.Runtime.X64.Core" Version="156.0.4314.42" />

    <!-- SQLite for history and bookmarks (browser.db). Same version Mozart uses. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- The icon file from AppIco above, copied next to neat.exe as neat.ico (build and
         publish). The settings window gives itself this icon in opts.xaml.cs; the exe's
         embedded icon cannot be handed to a window by path. -->
    <None Include="$(AppIco)" Link="neat.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The script the blocker gives every page (ads/pagejs.cs fills it in). Embedded, so it
         cannot go missing next to neat.exe. -->
    <EmbeddedResource Include="ads\page.js" LogicalName="neat.ads.page.js" />
  </ItemGroup>

  <!-- The ad blocker's two downloads, put in ads-dl\ by tools\fetch-ads.ps1 (CI runs it before
       the build): neat_adblock.dll from neatbrowser/neat-adblock, and a filter release from
       neatbrowser/neat-filters. They go next to neat.exe: the dll in the root, the filters in a
       "filters" folder. When ads-dl is empty the app still builds and runs, without a blocker. -->
  <ItemGroup>
    <None Include="..\..\ads-dl\neat_adblock.dll" Condition="Exists('..\..\ads-dl\neat_adblock.dll')"
          Link="neat_adblock.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\ads-dl\filters\*" Condition="Exists('..\..\ads-dl\filters\manifest.json')"
          Link="filters\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
