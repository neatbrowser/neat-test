<UserControl
    x:Class="neat.LibList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:n="using:neat">

    <!-- A list of Library rows with optional day headings: the page content of History and
         Bookmarks. It is a ListView, which only builds the rows on screen, so thousands of
         entries cost nothing until they are scrolled to. Its code is in liblist.xaml.cs. -->
    <UserControl.Resources>
        <!-- Dim text (the host under a title, day headings). The colour is set in code, in
             LibList.Paint, so it follows the window colour; the brush is changed in place. -->
        <SolidColorBrush x:Key="libdim"/>

        <DataTemplate x:Key="head" x:DataType="n:LibHead">
            <TextBlock
                Text="{x:Bind Text}"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{StaticResource libdim}"
                Margin="4,14,0,4"/>
        </DataTemplate>

        <!-- One page: favicon (a globe until there is one), title over host, and an X that
             shows while the pointer is on the row. -->
        <DataTemplate x:Key="row" x:DataType="n:LibRow">
            <Grid
                Height="48"
                ColumnSpacing="10"
                Background="Transparent"
                PointerEntered="row_In"
                PointerExited="row_Out">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    Source="{x:Bind Icon, Mode=OneWay}"
                    Visibility="{x:Bind IconVis, Mode=OneWay}"/>
                <FontIcon
                    Glyph="&#xE774;"
                    FontSize="14"
                    Foreground="{StaticResource libdim}"
                    Visibility="{x:Bind GlyphVis, Mode=OneWay}"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <TextBlock
                        Text="{x:Bind Host}"
                        FontSize="11"
                        Foreground="{StaticResource libdim}"
                        TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button
                    Grid.Column="2"
                    Width="28"
                    Height="28"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Visibility="Collapsed"
                    Click="del_Click"
                    ToolTipService.ToolTip="Remove">
                    <FontIcon Glyph="&#xE711;" FontSize="10"/>
                </Button>
            </Grid>
        </DataTemplate>

        <n:LibSel x:Key="sel" Head="{StaticResource head}" Row="{StaticResource row}"/>
    </UserControl.Resources>

    <Grid>
        <ListView
            x:Name="list"
            ItemTemplateSelector="{StaticResource sel}"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="list_ItemClick"
            ContainerContentChanging="list_Row">
            <!-- Same settings as the tab list in win.xaml: a light wash on hover and press, and
                 the selection accent bar switched off for real. With the bar on, hovering a row
                 can reach XAML code that sets the bar's background without checking that the bar
                 exists, and Microsoft.UI.Xaml.dll crashes (see the neat-crash-lessons skill).
                 Nothing here is ever selected, but the code path is removed anyway. The two
                 washes get their colours in LibList.Paint. -->
            <ListView.Resources>
                <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver"/>
                <SolidColorBrush x:Key="ListViewItemBackgroundPressed"/>
            </ListView.Resources>
        </ListView>

        <!-- "No history found" and the like, in the middle of the list. -->
        <TextBlock
            x:Name="empty"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="13"
            Foreground="{StaticResource libdim}"
            Visibility="Collapsed"/>
    </Grid>
</UserControl>
